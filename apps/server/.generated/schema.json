    "/api/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "pageIndex",
            "required": false,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "description": "Page number (zero-based)"
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "default": 10,
              "type": "number",
              "minimum": 1
            },
            "description": "Number of records per page"
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
